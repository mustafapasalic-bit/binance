# --- Exchange -----------------------------------------------------------
# testnet -> https://testnet.binance.vision (keys from https://testnet.binance.vision)
# live    -> https://api.binance.com  (key MUST be trade-only, no withdrawals, IP whitelisted)
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000

# --- Storage ------------------------------------------------------------
DATABASE_URL=sqlite:///./trader.db
# DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trader

# --- Risk limits --------------------------------------------------------
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_NOTIONAL_USDT=100
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_USDT=50
MAX_TRADES_PER_DAY=20
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
QUOTE_ASSET=USDT
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
MAX_SPREAD_PCT=0.15
MAX_SIGNAL_AGE_SEC=120

# --- Security -----------------------------------------------------------
# Trading starts disabled; it must be switched on explicitly via the dashboard/API.
TRADING_ENABLED=false
WEBHOOK_SECRET=change-me-long-random
ADMIN_TOKEN=change-me-long-random

# --- Alerting (optional) ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
